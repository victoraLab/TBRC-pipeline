# Host-local settings, sourced by snakemake.sh. Copy to site.env (not tracked).
#
# CLONALITY_LIB: an R library that holds a newer clonality than the conda env's
# own copy. Leave unset to use the env's copy. Build one with, for example:
#   R CMD INSTALL --library=/path/to/clonality-lib /path/to/clonality-checkout
# CLONALITY_LIB=/path/to/clonality-lib
