# Copy to .env in this folder and edit. Used as: docker compose --env-file .env up -d

# Image built by ./tbrc setup (docker build --target unified -t tbrc-unified:arm64 deploy/docker).
TBRC_IMAGE=tbrc-unified:arm64

# Login for the web page. `./tbrc setup` writes the hash. By hand, with the password kept off
# the command line:
#   printf '%s\n' 'the-password' | docker run --rm -i caddy:2-alpine caddy hash-password
# Double every $ in the hash ($$2a$$14$$...), or compose will eat it.
TBRC_USER=tbrc
TBRC_PASSWORD_HASH=

# 127.0.0.1 = only this computer can open the app (http://localhost:8080).
# 0.0.0.0   = anyone who can reach this computer on the network (keep the password set).
TBRC_BIND=127.0.0.1
TBRC_PORT=8080

# Local time zone of the lab, for run timestamps (e.g. America/New_York, Europe/Lisbon).
TBRC_TZ=UTC

# Upload limit in MB for the app's upload mode.
TBRC_MAX_UPLOAD_MB=8192

# Only for submitting to a cluster or reading a storage server: a folder holding a dedicated
# private key and a matching ssh `config`. Leave unset to mount ./ssh (placeholder only).
# TBRC_SSH_DIR=/path/to/a/folder/with/the/key
