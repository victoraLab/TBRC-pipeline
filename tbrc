# -- the plan, shown by --dry-run and used by the real run
def describe_config(cfg):
    keep = {"storage_server": cfg.get("storage_server"), "cluster": cfg.get("cluster")}
    return json.dumps(keep, indent=2).splitlines()


def command_text(cmd):
    return " ".join(shlex.quote(word) for word in cmd)


def docker_dir():
    return os.path.join(ROOT, "deploy", "docker")


def images_needed(local, web_ready):
    """[(image, Dockerfile target)] this setup needs. A run on this computer needs the backend image
    (which `tbrc run --local` looks for by name), unless every pipeline tool is already on PATH; the
    web app needs the unified image that docker-compose.yml runs, which also holds the pipeline."""
    need = []
    if local and not all(which(tool) for tool in LOCAL_TOOLS):
        need.append((SETUP_BACKEND_IMAGE, "backend"))
    if web_ready:
        need.append((SETUP_UNIFIED_IMAGE, "unified"))
    return need


def build_command(image, target):
    return ["docker", "build", "--target", target, "-t", image, docker_dir()]


WHAT_IMAGE_IS_FOR = {SETUP_BACKEND_IMAGE: "the pipeline tools, for runs on this computer",
                     SETUP_UNIFIED_IMAGE: "the web app together with the pipeline"}


def explain_missing(missing):
    say()
    say("These Docker images are missing:")
    for image, _ in missing:
        say("  {}  ({})".format(image, WHAT_IMAGE_IS_FOR[image]))
    say("Building them takes {} and needs internet (conda channels and GitHub). The commands are:".format(BUILD_TIME))
    for image, target in missing:
        say("  " + command_text(build_command(image, target)))


def build_images(missing):
    """Build the missing images, backend first (the unified one starts from its layers).
    Returns the ones that are still missing: none when all were built."""
    for number, (image, target) in enumerate(missing):
        say("Building {} ({}) ...".format(image, BUILD_TIME))
        rc, _, _ = run(build_command(image, target), stream=True)
        if rc != 0:
            status("fail", image, "the build exited with status {}".format(rc),
                   "the lines above say why; fix that and run ./tbrc setup again (images already built are kept)")
            return missing[number:]
        status("ok", image, "built")
    return []


