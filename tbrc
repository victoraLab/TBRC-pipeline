def add_run_options(p):
    p.add_argument("--user", required=True, help="submitter id; becomes the results folder name")
    p.add_argument("--run-name", default="", help="name of this run; becomes the sample name. In server mode it is the folder's last component and may be omitted")
    p.add_argument("--email", default="", help="notification address (optional)")
    src = p.add_argument_group("input (choose one)")
    src.add_argument("--server", default="", help="storage server name from server_config.json")
    src.add_argument("--folder", default="", help="folder under that server's rawdata_path holding the FASTQ pair")
    src.add_argument("--fastq-dir", default="", help="local folder holding exactly one R1 and one R2 FASTQ")
    src.add_argument("--r1", default="", help="local R1 FASTQ")
    src.add_argument("--r2", default="", help="local R2 FASTQ")
    lib = p.add_argument_group("library")
    lib.add_argument("--primer-set", required=True, help="barcode set folder under backend/data/barcodes, e.g. B2 or T")
    lib.add_argument("--pipeline", default="tiago_vsearch", choices=PIPELINES)
    lib.add_argument("--protocol", default=DEFAULTS["protocol"], choices=("standard", "luka_light"),
                     help="barcode preprocessing; luka_light strips the light-chain primer and tail during splitting")
    lib.add_argument("--contigs", type=int, default=DEFAULTS["contigs"], help="sequences to keep per well (default 3)")
    lib.add_argument("--trim-seq", default="", help="5' handle to trim at the end; default comes from barcode_defaults")
    lib.add_argument("--no-trim-primers", dest="trim_primers", action="store_false", default=True)
    ann = p.add_argument_group("annotation")
    ann.add_argument("--no-igblast", dest="igblast", action="store_false", default=True)
    ann.add_argument("--clonality", action="store_true", default=False)
    ann.add_argument("--species", default=DEFAULTS["species"], choices=SPECIES)
    ann.add_argument("--panel", default=DEFAULTS["panel"], choices=PANELS,
                     help="germline panel; the receptor check widens a single-locus panel when the plate needs it")
    ann.add_argument("--receptor-check", default=DEFAULTS["receptor_check"], choices=("auto", "warn", "off"))
    out = p.add_argument_group("output")
    out.add_argument("--archive-format", default=DEFAULTS["archive_format"], choices=("zip", "tar.gz"))
    out.add_argument("--archive-scope", default=DEFAULTS["archive_scope"], choices=("light", "full"))
    out.add_argument("--run-group", default="", metavar="NAME",
                     help="push the archive to results/<user>/NAME/ so several runs of one plate land together")
    out.add_argument("--keep-raw", action="store_true", default=False, help="keep bulky intermediates on disk")
    out.add_argument("--transfer-mode", default=DEFAULTS["transfer_mode"], choices=("push", "pull"),
                     help="push the archive to the storage server, or leave it where it was made")
    out.add_argument("--push", action="store_true", default=False,
                     help="also push from a --local or --fastq-dir run (off by default for those)")
    out.add_argument("--sequencing-kit", default="", help="recorded only")
    mibs = p.add_argument_group("MIBS / tiago_sulkseq")
    mibs.add_argument("--platemap", default="", help="experimental design TSV for a MIBS run")
    for key in ("mibs_junction_max_distance", "mibs_min_reads_per_well", "mibs_min_wells_per_clone", "mibs_min_reads_per_cluster"):
        mibs.add_argument("--" + key.replace("_", "-"), type=int, default=DEFAULTS[key])
    mibs.add_argument("--mibs-gene-grouping", default=DEFAULTS["mibs_gene_grouping"], choices=("strict", "transitive"))
    mibs.add_argument("--mibs-clone-scope", default=DEFAULTS["mibs_clone_scope"], choices=("sample", "global"))
    mibs.add_argument("--mibs-productive-only", action="store_true", default=False)
    where = p.add_argument_group("where to run")
    where.add_argument("--local", action="store_true", help="run the workflow on this machine (snakemake on PATH, or a tbrc-backend Docker image)")
    where.add_argument("--cores", type=int, default=4, help="cores for a --local run")
    where.add_argument("--docker-image", default="", help="image to use for a --local run (default: first tbrc-backend image found)")
    where.add_argument("--dry-run", action="store_true", help="write nothing on the cluster; show the sample.json and the commands")
    where.add_argument("--plan", action="store_true", help="with --dry-run --local: stage the run and let snakemake plan it (-n)")
    where.add_argument("--force", action="store_true", help="reuse an existing run folder")


def build_parser():
    ap = argparse.ArgumentParser(prog="tbrc", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="command", required=True)

    st = sub.add_parser("setup", help="ask a few questions, write the configuration, build and check what is needed")
    st.add_argument("--answers", metavar="FILE.json", default="",
                    help="take the answers from this JSON file instead of asking (for scripts and tests)")
    st.add_argument("--dry-run", action="store_true", help="say what would be written and run; write and run nothing")
    st.add_argument("--force", action="store_true",
                    help="replace existing files without asking (a dated .bak copy is always kept); "
                         "needed with --answers")
    st.add_argument("--test-data", metavar="DIR", default="",
                    help="folder with the small test library (one R1, one R2) to run as a first test")
    st.add_argument("--build-images", action="store_true",
                    help="build the Docker images that are missing ({}, needs internet); without a terminal, "
                         "setup stops with the command instead".format(BUILD_TIME))
    st.add_argument("--start", action="store_true",
                    help="start the web app when setup is done; without a terminal setup only prints the commands")
    st.set_defaults(func=cmd_setup)

    c = sub.add_parser("check", help="verify configuration, HPC, storage servers and (with --local) this machine")
    c.add_argument("--local", action="store_true", help="check only what a --local run needs")
    c.add_argument("--all", action="store_true", help="check the HPC, the storage servers and this machine")
    c.add_argument("--server", default="", help="check only this storage server")
    c.add_argument("--no-storage", action="store_true", help="skip the storage-server checks (uploads only)")
    c.set_defaults(func=cmd_check)

    r = sub.add_parser("run", help="submit a run")
    add_run_options(r)
    r.set_defaults(func=cmd_run)

    t = sub.add_parser("test", help="self-test: columns, workflow dry run, optionally a real run")
    t.add_argument("--hpc", action="store_true", help="do the dry run on the cluster even if snakemake is available here")
    t.add_argument("--full", action="store_true", help="also run a real dataset end to end")
    t.add_argument("--fastq-dir", default="", help="dataset for --full")
    t.add_argument("--r1", default="")
    t.add_argument("--r2", default="")
    t.add_argument("--primer-set", default="B2")
    t.add_argument("--pipeline", default="tiago_vsearch", choices=PIPELINES)
    t.add_argument("--local", action="store_true", help="run the --full test on this machine")
    t.add_argument("--cores", type=int, default=4)
    t.set_defaults(func=cmd_test)
    return ap


def main(argv=None):
    a = build_parser().parse_args(argv)
    try:
        return a.func(a)
    except Fail as exc:
        say("error: {}".format(exc))
        if exc.hint:
            say("hint:  {}".format(exc.hint))
        return 2
    except KeyboardInterrupt:
        say("\ninterrupted")
        if SETUP_WRITTEN:
            say("files already written by setup: {} (a replaced file is kept as a .bak copy next to it)".format(
                ", ".join(rel_path(w) for w in SETUP_WRITTEN)))
        return 130


if __name__ == "__main__":
    sys.exit(main())
