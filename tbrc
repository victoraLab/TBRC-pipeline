    "    submit a run under any user id, and the app uses whatever cluster or storage-server key it holds for all of them.",
    "  - For HTTPS, change deploy/docker/Caddyfile as the comment at its top describes (a host name instead of :8080,",
    "    ports 80 and 443 published in docker-compose.yml), or put the app behind your institution's own TLS proxy.",
)


def web_address(bind):
    """What to open: localhost for this computer only; for the whole lab, this computer's real name."""
    if bind == "127.0.0.1":
        return "localhost"
    return socket.gethostname() or "<this computer's name>"


def web_folders():
    return [os.path.join(BACKEND, *folder.split("/")) for folder in WEB_WRITABLE_FOLDERS]


def make_web_folders():
    """Make the folders the web container writes in. They must exist before it starts: Docker cannot create a
    mount point inside the read-only mount of backend/."""
    for folder in web_folders():
        os.makedirs(folder, exist_ok=True)


def start_commands():
    return [["docker", "compose", "--env-file", ".env", "up", "-d"], ["bash", "seed-barcodes.sh"]]


def start_web_app(folder):
    """compose up with the .env, then seed the barcode sets. True unless one failed."""
    up, seed = start_commands()
    rc, _, _ = run(up, cwd=folder, stream=True)
    if rc != 0:
        status("fail", "web app", "docker compose exited with status {}".format(rc),
               "the lines above say why; fix that, then run the commands under 'start the web app' by hand")
        return False
    rc, _, _ = run(seed, cwd=folder, stream=True)
    if rc != 0:
        status("fail", "web app", "seed-barcodes.sh exited with status {}".format(rc),
               "the app is running; run: cd {} && bash seed-barcodes.sh".format(shlex.quote(rel_path(folder))))
        return False
    status("ok", "web app", "started")
    return True


def cmd_setup(a):
    given = load_answers(a.answers) if a.answers else None
    if given and given.get("password") and os.stat(a.answers).st_mode & 0o077:
        status("warn", "answers file", "holds a password in the clear and other users can read it",
               "chmod 600 it, or give password_hash instead, and delete the file when setup is done")
    asker = Asker(given)
    example = os.path.join(FRONTEND, "server_config.example.json")
    if not os.path.isfile(example):
        raise Fail("cannot find {}".format(rel_path(example)),
                   "setup starts from that file, which is in a clone of the public TBRC-pipeline repository.")
    try:
        with open(example, encoding="utf-8") as handle:
            template = json.load(handle)
    except ValueError as exc:
        raise Fail("{} is not valid JSON: {}".format(rel_path(example), exc))
    sample_rules_module()   # the names and paths are judged by the workflow's rules; stop now if they are missing

    say("tbrc setup: a few questions, then it writes the configuration." + ("  (dry run: nothing is written or run)"
                                                                          if a.dry_run else ""))
    ans = collect_setup_answers(asker, a.test_data or None)
    local = ans["runs_on"] == "local"
    web = ans["interface"] == "web"
    if web and ans.get("audience") == "lab":
        say()
        for line in LAB_NOTE:
            say(line)
    kit = docker_dir()
    env_example = os.path.join(kit, "env.example")
    dockerfile = os.path.join(kit, "Dockerfile")
    kit_ready = web and os.path.isfile(env_example) and os.path.isfile(os.path.join(kit, "docker-compose.yml"))
    if web and not kit_ready:
        say()
        status("warn", "web app", "deploy/docker/ is not in this checkout",
               "it is part of the repository, so this checkout is incomplete or older than that folder: git pull "
               "(or clone the repository again), then run ./tbrc setup again. Everything else goes on now.")
    password = None
    if kit_ready and not a.dry_run:
        password = asker.password()

    # what will be written
    files = [{"label": "configuration", "path": CONFIG_FILE, "private": False,
              "text": json.dumps(build_server_config(template, ans), indent=2) + "\n"}]
    cfg = json.loads(files[0]["text"])
    if not local:
        cluster_json = os.path.join(BACKEND, "config", "cluster.json")
        if os.path.isfile(cluster_json):
            with open(cluster_json, encoding="utf-8") as handle:
                files.append({"label": "SLURM account and partition", "path": cluster_json, "private": False,
                              "text": build_cluster_json(handle.read(), ans)})
        else:
            status("warn", "SLURM account and partition", "backend/config/cluster.json is missing",
                   "set __default__.account and partition in it on the cluster")
    bind = "127.0.0.1" if ans.get("audience") == "me" else "0.0.0.0"
    if kit_ready:
        with open(env_example, encoding="utf-8") as handle:
            env_text = handle.read()
        files.append({"label": "web app login", "path": os.path.join(kit, ".env"), "private": True,
                      "text": None, "env_example": env_text, "bind": bind})

    existing = [f for f in files if os.path.exists(f["path"])]
    refused = []
    if existing and not a.force:
        if asker.interactive:
            if not a.dry_run:
                for f in existing:
                    if not asker.confirm("{} already exists, and the {} would change it. Go ahead? A dated copy is "
                                         "kept next to it ({}.bak-{}).".format(
                                             rel_path(f["path"]), f["label"], rel_path(f["path"]), timestamp())):
                        f["skip"] = True
        else:
            refused = existing

    # Docker images that are needed and missing. Without a terminal this stops before anything is written,
    # unless --build-images says to build them; in a terminal it asks.
    need = images_needed(local, kit_ready)
    have = docker_installed_images() if need else set()
    missing = [item for item in need if have is None or item[0] not in have]
    image_stop = None
    build_now = False
    if missing:
        commands = [build_command(image, target) for image, target in missing]
        how = "; ".join(command_text(c) for c in commands)
        if have is None:
            image_stop = ("Docker is not installed or is not running, and these images are missing: {}".format(
                ", ".join(image for image, _ in missing)),
                          "install Docker Desktop and start it, then run ./tbrc setup again")
        elif not os.path.isfile(dockerfile):
            image_stop = ("these Docker images are missing and deploy/docker/Dockerfile, which builds them, is not "
                          "in this checkout: {}".format(", ".join(image for image, _ in missing)),
                          "it is part of the repository: git pull (or clone it again), then run ./tbrc setup again")
        else:
            if a.build_images or asker.interactive:
                explain_missing(missing)
            if a.build_images:
                build_now = True
            elif asker.interactive:
                if not a.dry_run:
                    build_now = asker.confirm("Build them now? ({})".format(BUILD_TIME))
            else:
                image_stop = ("Docker images are missing: {}. Building them takes {} and needs internet".format(
                    ", ".join(image for image, _ in missing), BUILD_TIME),
                              "pass --build-images to build them as part of setup, or run: {}; then run ./tbrc "
                              "setup again".format(how))
        if image_stop and asker.interactive and not a.dry_run:
            status("warn", "Docker images", image_stop[0], image_stop[1])   # carry on: the files are still worth writing
            image_stop = None

    if a.dry_run:
        say()
        plan_setup(files, ans, local, kit_ready, missing, build_now or a.build_images, asker.interactive, a)
        if refused:
            raise_refused(refused)
        if image_stop:
            raise Fail(*image_stop)
        return 0
    if refused:
        raise_refused(refused)
    if image_stop:
        raise Fail(*image_stop)

    # the hash is made only when every file is settled (and the .env is not being kept), and before
    # anything is written
    env_file = next((f for f in files if f.get("env_example") is not None), None)
    if env_file is not None and not env_file.get("skip"):
        kind, secret = password
        env_hash = hash_password(secret) if kind == "plain" else secret
        env_file["text"] = build_env(env_file["env_example"], env_file["bind"], env_hash.replace("$", "$$"))
    problems = 0
    stamp = timestamp()
    del SETUP_WRITTEN[:]
    say()
    say("== writing")
    for f in files:
        if f.get("skip"):
            status("skip", f["label"], "kept as it was: {}".format(rel_path(f["path"])))
            continue
        try:
            backup = write_file(f["path"], f["text"], f["private"], stamp)
        except OSError as exc:
            raise Fail("could not write {}: {}".format(rel_path(f["path"]), exc.strerror or exc),
                       "already written: {}. A replaced file is kept as a .bak copy next to it. Fix the cause and "
                       "run ./tbrc setup again.".format(", ".join(rel_path(w) for w in SETUP_WRITTEN) or "nothing"))
        SETUP_WRITTEN.append(f["path"])
        status("ok", f["label"], "wrote {}{}".format(rel_path(f["path"]), " (mode 600)" if f["private"] else ""))
        if backup:
            say("       the previous file is kept as {}".format(rel_path(backup)))

    if kit_ready:
        try:
            make_web_folders()
        except OSError as exc:
            raise Fail("could not make the web app's folders under backend/: {}".format(exc.strerror or exc),
                       "make them by hand: mkdir -p " + " ".join(rel_path(f) for f in web_folders()))
        status("ok", "web app folders", ", ".join(rel_path(f) for f in web_folders()))

    if missing:
        say()
        say("== Docker images")
        if build_now:
            missing = build_images(missing)
        else:
            say("Not built. To build them later, run ./tbrc setup --build-images, or:")
            for image, target in missing:
                say("  " + command_text(build_command(image, target)))
        if missing:
            problems += 1
    missing_names = [image for image, _ in missing]

    if local:
        say()
        say("== this computer")
        if not build_igblast():
            problems += 1
    else:
        say()
        placeholder = "/path/to/" in (cfg.get("cluster") or {}).get("path_prefix", "")
        cluster_todo(ans, not placeholder)
    say()
    say("== ./tbrc check{}".format(" --local" if local else ""))
    try:
        rc = cmd_check(argparse.Namespace(local=local, all=False, server="", no_storage=(ans["data"] == "upload")))
    except Fail as exc:
        status("fail", "check", str(exc), exc.hint)
        rc = 1
    if rc:
        problems += 1
    if ans["test_data"]:
        say()
        say("== test library")
        if not run_test_library(ans["test_data"], local):
            problems += 1
    if kit_ready:
        say()
        say("== the web app")
        can_start = SETUP_UNIFIED_IMAGE not in missing_names and os.path.isfile(os.path.join(kit, ".env"))
        start = False
        if can_start:
            start = a.start or (asker.interactive and asker.confirm(
                "Start the web app now?", default=True))
        if start:
            if not start_web_app(kit):
                problems += 1
                start = False
        if start:
            say("  To stop it later: cd {} && docker compose --env-file .env down".format(shlex.quote(rel_path(kit))))
        else:
            if not can_start:
                problems += 0 if missing_names else 1     # a missing image was counted above
                say("  Not started: the web app image {} or {} is missing.".format(
                    SETUP_UNIFIED_IMAGE, rel_path(os.path.join(kit, ".env"))))
            say("  To start it:")
            say("  cd {}".format(shlex.quote(rel_path(kit))))
            say("  docker compose --env-file .env up -d")
            say("  bash seed-barcodes.sh")
        login = re.search(r"^TBRC_USER=(\S+)", env_file["env_example"], re.M)
        say("  Then open http://{}:8080 and log in as {} with the password you chose.".format(
            web_address(bind), login.group(1) if login else "tbrc"))
        if bind == "0.0.0.0":
            say("  It listens on 0.0.0.0 over plain HTTP, so everyone who can reach this computer sees the login page and "
                "the password and the data cross the network unencrypted (see the note above). Keep the password private.")
        if not local:
            say("  The app reaches the cluster with a dedicated key: put it in a folder and set TBRC_SSH_DIR in "
                "{}/.env (see {}/ssh/config).".format(rel_path(kit), rel_path(kit)))
    say()
    if problems:
        say("Setup wrote its files, but {} step(s) above need attention.".format(problems))
        return 1
    say("Setup finished.")
    return 0


def raise_refused(refused):
    names = ", ".join(rel_path(f["path"]) for f in refused)
    raise Fail("already exists: {}".format(names),
               "a run without a terminal never overwrites a file on its own. Pass --force to replace it; a dated "
               ".bak-YYYYMMDD-HHMMSS copy is kept next to it.")


def plan_setup(files, ans, local, kit_ready, missing, will_build, interactive, a):
    for f in files:
        state = "replaces an existing file, kept as {}.bak-<date-time>".format(rel_path(f["path"])) \
            if os.path.exists(f["path"]) else "new file"
        say("would write {} ({}){}".format(rel_path(f["path"]), state, ", mode 600" if f["private"] else ""))
        if f["label"] == "configuration":
            for line in describe_config(json.loads(f["text"])):
                say("    " + line)
        elif f["label"].startswith("SLURM"):
            say("    __default__.account = {!r}, partition = {!r}".format(ans["slurm_account"], ans["slurm_partition"]))
        else:
            for line in build_env(f["env_example"], f["bind"], "<the hash of the password you choose; never shown>").splitlines():
                if re.match(r"TBRC_(USER|BIND|PORT|PASSWORD_HASH|IMAGE)=", line):
                    say("    " + line)
    if kit_ready:
        say("would make {} (the folders the web app may write in; the rest of backend/ is mounted read-only)".format(
            ", ".join(rel_path(f) for f in web_folders())))
        say("would run: {}   (the password goes in on standard input)".format(" ".join(HASH_COMMAND)))
    for image, target in missing:
        if will_build:
            say("would build {}: {}".format(image, command_text(build_command(image, target))))
        elif interactive:
            say("would ask whether to build {}: {}".format(image, command_text(build_command(image, target))))
        else:
            say("would build {} only with --build-images, and otherwise stop here: {}".format(
                image, command_text(build_command(image, target))))
    if local:
        if igblast_built():
            say("would skip building the IgBLAST databases: already built")
        else:
            say("would run: " + command_text(igblast_command(docker_image() or "<tbrc-backend image>")))
        say("would run: ./tbrc check --local")
    else:
        say("would print what is left to do on the cluster, then run: ./tbrc check{}".format(
            " --no-storage" if ans["data"] == "upload" else ""))
    if ans["test_data"]:
        say("would run: ./tbrc run {}{} --fastq-dir {} --force".format(
            " ".join(shlex.quote(w) for w in TEST_LIBRARY), " --local" if local else "", shlex.quote(ans["test_data"])))
    if kit_ready:
        up, seed = start_commands()
        if a.start:
            say("would run: {}   (in deploy/docker)".format(" ".join(up)))
            say("would run: {}   (in deploy/docker)".format(" ".join(seed)))
        elif interactive:
            say("would ask whether to start the web app (docker compose --env-file .env up -d, then bash seed-barcodes.sh)")
        else:
            say("would print how to start the web app (docker compose --env-file .env up -d, then bash seed-barcodes.sh)")
    say("Dry run: nothing was written or run.")


def run_test_library(folder, local):
    """Run the mini library and say whether it finished. True if it did."""
    argv = ["run"] + TEST_LIBRARY + ["--fastq-dir", folder, "--force"] + (["--local"] if local else [])
    say("Running the test library {} ({}) ...".format("TCRb_mini", "on this computer" if local else "on the cluster"))
    try:
        args = build_parser().parse_args(argv)
        rc = args.func(args)
    except Fail as exc:
        status("fail", "test library TCRb_mini", str(exc), exc.hint)
        return False
    except SystemExit:
        status("fail", "test library TCRb_mini", "the run options were not accepted")
        return False
    if rc != 0:
        status("fail", "test library TCRb_mini", "did not finish (exit status {})".format(rc))
        return False
    status("ok", "test library TCRb_mini", "finished")
    return True


