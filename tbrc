def timestamp():
    return datetime.datetime.now().strftime("%Y%m%d-%H%M%S")


# -- the checks: each takes the text of an answer and returns the value to keep, or raises ValueError
def check_choice(*options):
    """options: (value, word, ...) in the order the menu lists them. The number or any word picks one."""
    def check(text):
        said = text.strip().lower()
        for number, option in enumerate(options, 1):
            if said == str(number) or said in option:
                return option[0]
        raise ValueError("answer {}, or one of: {}".format(
            " or ".join(str(n) for n in range(1, len(options) + 1)), ", ".join(o[0] for o in options)))
    return check


def check_segment(text):
    if not sample_rules_module()._segment_ok(text):
        raise ValueError("use one word of letters, digits, dot, underscore or hyphen (no spaces, "
                         "not starting with a hyphen)")
    return text


def check_server_name(text):
    check_segment(text)
    if text.lower() in ("local", "upload") or len(text) > 40:
        raise ValueError("pick another name: not 'local' or 'upload', and at most 40 characters")
    return text


def check_login(text):
    if len(text) > 300 or ".." in text or LOGIN_RE.fullmatch(text) is None:
        raise ValueError("write a host name, or user@host: letters, digits, dots and hyphens, no spaces, "
                         "not starting with a hyphen")
    return text


def check_login_or_blank(text):
    return check_login(text) if text else ""


def check_remote_path(text):
    """user@host:/folder/ in the plain-path alphabet of the workflow (no spaces, no .., no ~)."""
    match = REMOTE_RE.fullmatch(text)
    if (match is None or not match.group(3).strip("/") or ".." in match.group(2)
            or not sample_rules_module()._path_ok(text)):
        raise ValueError("write it as user@host:/folder/ using letters, digits and . _ / @ : + - only "
                         "(no spaces, no .., no ~)")
    return text if text.endswith("/") else text + "/"


def check_port(text):
    if re.fullmatch(r"[0-9]{1,5}", text) is None or not 0 < int(text) < 65536:
        raise ValueError("write a port number from 1 to 65535")
    return int(text)


def check_folder(text):
    """An absolute folder on another machine, in the plain-path alphabet."""
    if (FOLDER_RE.fullmatch(text) is None or not text.strip("/") or "//" in text
            or not sample_rules_module()._path_ok(text)):
        raise ValueError("write an absolute path using letters, digits and . _ / + - only (no spaces, no .., no ~)")
    return text.rstrip("/")


def check_folder_or_blank(text):
    return check_folder(text) if text else ""


def check_slurm_account(text):
    if text and NAME_RE.fullmatch(text) is None:
        raise ValueError("write a SLURM account name (letters, digits, dot, underscore, hyphen), or leave it blank")
    return text


def check_slurm_partition(text):
    names = text.split(",")
    if not text or any(NAME_RE.fullmatch(n) is None for n in names):
        raise ValueError("write a partition name (letters, digits, dot, underscore, hyphen); a comma-separated "
                         "list is fine")
    return text


def check_test_folder(text):
    if not text:
        return ""
    folder = os.path.abspath(os.path.expanduser(text))
    if not os.path.isdir(folder):
        raise ValueError("that is not a folder")
    return folder


def check_password(text):
    if len(text) < 8 or any(c in text for c in "\r\n\0"):
        raise ValueError("use at least 8 characters, on one line")
    if len(text.encode("utf-8")) > 72:
        raise ValueError("use at most 72 bytes: bcrypt, which protects the login, cannot take more "
                         "(accented letters and emoji count as 2 to 4 bytes each)")
    return text


# -- asking
class Asker:
    """The setup questions, one at a time: on the terminal (a bad answer is asked again) or from an
    --answers file (a bad answer is refused, naming the key, since nobody is there to ask)."""

    def __init__(self, given=None):
        self.given = given

    @property
    def interactive(self):
        return self.given is None

    def ask(self, key, question, check, menu=(), default=None, optional=False):
        if self.given is not None:
            raw = self.given.get(key)
            if raw is None or (isinstance(raw, str) and raw == "" and default is not None):
                if default is not None:
                    raw = default
                elif optional:
                    raw = ""
                else:
                    raise Fail("answers file: {} is missing".format(key), "it is one of: " + ", ".join(SETUP_ANSWERS))
            if isinstance(raw, bool) or not isinstance(raw, (str, int)):
                raise Fail("answers file: {} must be text or a number".format(key))
            try:
                return check(str(raw))
            except ValueError as exc:
                raise Fail("answers file: {}: {}".format(key, exc))
        shown = question + "".join("\n" + line for line in menu)
        if default is not None:
            shown += "\n(press Enter for {})".format(default)
        elif optional:
            shown += "\n(press Enter to skip)"
        while True:
            try:
                typed = input("\n" + shown + "\n> ").strip()
            except EOFError:
                raise Fail("the input ended before every question was answered", "nothing was changed.")
            if typed == "" and default is not None:
                typed = str(default)
            try:
                return check(typed)
            except ValueError as exc:
                say("  Not accepted: {}. Please try again.".format(exc))

    def confirm(self, question, default=False):
        while True:
            try:
                typed = input("\n" + question + (" [Y/n] " if default else " [y/N] ")).strip().lower()
            except EOFError:
                raise Fail("the input ended before every question was answered", "nothing was changed.")
            if typed == "":
                return default
            if typed in ("n", "no"):
                return False
            if typed in ("y", "yes"):
                return True
            say("  Please answer y or n.")

    def password(self):
        """('plain', password) or ('hash', bcrypt hash)."""
        if self.given is not None:
            hashed = self.given.get("password_hash")
            if hashed:
                if not isinstance(hashed, str) or BCRYPT_RE.fullmatch(hashed) is None:
                    raise Fail("answers file: password_hash is not a bcrypt hash",
                               "make one with: docker run --rm -i caddy:2-alpine caddy hash-password")
                return "hash", hashed
            plain = self.given.get("password")
            if plain is None or plain == "":
                raise Fail("answers file: password is missing",
                           "the web app always needs a password; give password, or password_hash")
            if not isinstance(plain, str):
                raise Fail("answers file: password must be text")
            try:
                return "plain", check_password(plain)
            except ValueError as exc:
                raise Fail("answers file: password: {}".format(exc))
        while True:
            try:
                first = getpass.getpass("\nChoose a password for the web app (hidden, at least 8 characters): ")
                second = getpass.getpass("Type it again: ")
            except EOFError:
                raise Fail("the input ended before every question was answered", "nothing was changed.")
            if first != second:
                say("  The two passwords differ. Please try again.")
                continue
            try:
                return "plain", check_password(first)
            except ValueError as exc:
                say("  Not accepted: {}. Please try again.".format(exc))


def load_answers(path):
    try:
        with open(path, encoding="utf-8") as handle:
            data = json.load(handle)
    except OSError as exc:
        raise Fail("cannot read the answers file {}: {}".format(path, exc.strerror or exc))
    except ValueError as exc:
        raise Fail("the answers file {} is not valid JSON: {}".format(path, exc))
    if not isinstance(data, dict):
        raise Fail("the answers file {} must hold one JSON object".format(path))
    unknown = sorted(k for k in data if k not in SETUP_ANSWERS)
    if unknown:
        raise Fail("answers file: unknown answer(s): {}".format(", ".join(unknown)),
                   "the names are: " + ", ".join(SETUP_ANSWERS))
    return data


def collect_setup_answers(asker, test_data):
    """The answers to the four questions and to the cluster ones, validated. `test_data` is the folder
    from --test-data, or None to ask."""
    ans = {}
    ans["runs_on"] = asker.ask(
        "runs_on", "Will your runs happen on this computer, or on a cluster?",
        check_choice(("local", "this", "this computer", "computer", "here"),
                     ("cluster", "a cluster", "hpc", "slurm")),
        menu=["  1) on this computer",
              "  2) on a cluster (a shared system you log in to over SSH; it runs the jobs with SLURM)"])
    ans["data"] = asker.ask(
        "data", "Where is your raw data?",
        check_choice(("upload", "uploaded", "app", "this computer"), ("server", "file server", "ssh")),
        menu=["  1) on this computer: I upload it through the app, or give tbrc a folder",
              "  2) on a file server I reach over SSH"])
    if ans["data"] == "server":
        ans["server_name"] = asker.ask(
            "server_name", "Give that file server a short name, for example labnas (letters, digits, . _ -):",
            check_server_name)
        ans["server_raw"] = asker.ask(
            "server_raw", "Where does the raw data live on it? Write it as user@host:/folder/ :", check_remote_path)
        ans["server_results"] = asker.ask(
            "server_results", "Where should finished results go on it? Write it as user@host:/folder/ :",
            check_remote_path)
        ans["server_port"] = asker.ask("server_port", "SSH port of that file server:", check_port, default="22")
    ans["interface"] = asker.ask(
        "interface", "Do you want to work in the terminal only, or use the web app too?",
        check_choice(("terminal", "terminal only", "shell"), ("web", "web app", "app", "browser")),
        menu=["  1) the terminal only", "  2) the web app"])
    if ans["interface"] == "web":
        ans["audience"] = asker.ask(
            "audience", "Who will open the web app?",
            check_choice(("me", "only me", "this computer", "me only"), ("lab", "the whole lab", "everyone", "network")),
            menu=["  1) only me, on this computer",
                  "  2) the whole lab, over the network (served over plain HTTP, with one shared password for everyone;"
                  " a note follows)"])
    if ans["runs_on"] == "cluster":
        ans["login_host"] = asker.ask(
            "login_host", "Login host of the cluster, as you type it after ssh (host or user@host):", check_login)
        ans["dtn_host"] = asker.ask(
            "dtn_host", "Data-transfer host of the cluster (host or user@host):", check_login_or_blank, optional=True)
        ans["backend_path"] = asker.ask(
            "backend_path", "Folder on the cluster that holds (or will hold) the backend, the one with "
            "snakemake.sh in it. Write the absolute path:", check_folder)
        ans["conda_env"] = asker.ask(
            "conda_env", "Name of the conda environment on the cluster:", check_segment, default="snakemake")
        ans["conda_path"] = asker.ask(
            "conda_path", "Folder on the cluster that holds the conda command (usually .../miniforge3/condabin):",
            check_folder_or_blank, optional=True)
        ans["slurm_account"] = asker.ask(
            "slurm_account", "SLURM account to charge:", check_slurm_account, optional=True)
        ans["slurm_partition"] = asker.ask(
            "slurm_partition", "SLURM partition to use:", check_slurm_partition)
    if test_data is None:
        ans["test_data"] = asker.ask(
            "test_data", "Folder with a small test library (one R1 and one R2 FASTQ) to run as a first test:",
            check_test_folder, optional=True)
    else:
        try:
            ans["test_data"] = check_test_folder(test_data)
        except ValueError as exc:
            raise Fail("--test-data: {}".format(exc))
    return ans


# -- what gets written
def build_server_config(template, ans):
    """The example config with the answers filled in. A run on this computer is never "push": a
    local run would try to copy its archive to the file server, and be recorded as failed. The launch
    gate (cluster.use_gate) is lab-specific and is never set."""
    cfg = json.loads(json.dumps(template))
    cluster = cfg.setdefault("cluster", {})
    cluster.pop("use_gate", None)
    local = ans["runs_on"] == "local"
    if ans["data"] == "server":
        cfg["storage_server"] = {ans["server_name"]: {
            "rawdata_path": ans["server_raw"], "results_path": ans["server_results"],
            "ssh_port": ans["server_port"], "web_port": 0, "transfer_mode": "pull" if local else "push"}}
    else:
        # the app lists at least one server; with no real one the archive stays where it was made
        for entry in (cfg.get("storage_server") or {}).values():
            if isinstance(entry, dict):
                entry["transfer_mode"] = "pull"
    if not local:
        root = ans["backend_path"]
        cluster.update({"ssh_host": ans["login_host"], "dtn_host": ans["dtn_host"], "pipeline_root": root,
                        "snakemake_env": ans["conda_env"], "igblast_data": root + "/igblast/internal_data",
                        "igblast_auxiliary_data": root + "/igblast/optional_file"})
        if ans["conda_path"]:
            cluster["path_prefix"] = ans["conda_path"] + ":" + PATH_PREFIX_TAIL
    return cfg


def build_cluster_json(text, ans):
    try:
        data = json.loads(text)
        default = data.setdefault("__default__", {})
    except (ValueError, AttributeError):
        raise Fail("backend/config/cluster.json is not a JSON object with a __default__ section")
    default["account"] = ans["slurm_account"]
    default["partition"] = ans["slurm_partition"]
    return json.dumps(data, indent=4) + "\n"


def build_env(example, bind, env_hash):
    """env.example with the login hash and the address to listen on filled in. The hash is written with
    every $ doubled, because compose expands $ in .env values."""
    lines, seen = [], set()
    for line in example.splitlines():
        key = line.split("=", 1)[0] if re.match(r"[A-Z_]+=", line) else None
        if key == "TBRC_PASSWORD_HASH":
            line = "TBRC_PASSWORD_HASH=" + env_hash
        elif key == "TBRC_BIND":
            line = "TBRC_BIND=" + bind
        if key:
            seen.add(key)
        lines.append(line)
    if "TBRC_PASSWORD_HASH" not in seen:
        lines.append("TBRC_PASSWORD_HASH=" + env_hash)
    if "TBRC_BIND" not in seen:
        lines.append("TBRC_BIND=" + bind)
    return "\n".join(lines) + "\n"


def hash_password(password):
    """The bcrypt hash caddy makes. The password goes in on standard input, never on a command line."""
    rc, out, err = run(HASH_COMMAND, stdin=password + "\n", timeout=300)
    hashed = out.strip()
    if rc != 0 or BCRYPT_RE.fullmatch(hashed) is None:
        detail = (err or "").replace(password, "***").strip().splitlines()
        raise Fail("could not make the password hash (caddy hash-password exited {})".format(rc),
                   "Docker has to be running, and the image caddy:2-alpine is downloaded the first time, which "
                   "needs internet. Nothing was changed." + (" Docker said: " + detail[-1] if detail else ""))
    return hashed


def write_file(path, text, private, stamp):
    """Write `text` to `path` through a new file beside it. An existing file is copied to
    <path>.bak-<stamp> first (never overwriting an older backup); returns the backup's path or None."""
    backup = None
    if os.path.exists(path):
        backup = "{}.bak-{}".format(path, stamp)
        number = 1
        while os.path.exists(backup):
            backup = "{}.bak-{}-{}".format(path, stamp, number)
            number += 1
        if private:
            # created with mode 600 from the start: a copy made at the umask default would be readable by
            # others for a moment, and it holds the old login hash
            fd = os.open(backup, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            with os.fdopen(fd, "wb") as copy, open(path, "rb") as original:
                shutil.copyfileobj(original, copy)
        else:
            shutil.copy2(path, backup)
        mode = 0o600 if private else stat_mode(path)
    else:
        mode = 0o600 if private else 0o644
    tmp = "{}.new{}".format(path, os.getpid())
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, mode)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(text)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)
    return backup


def stat_mode(path):
    return os.stat(path).st_mode & 0o777


def rel_path(path):
    return os.path.relpath(path, ROOT)


# -- what gets run
def igblast_built():
    work = os.path.join(BACKEND, "igblast", "work")
    return os.path.isdir(os.path.join(BACKEND, "igblast", "internal_data")) and all(
        glob.glob(os.path.join(work, species, panel, "*_V.nhr")) for species, panel in IGBLAST_PANELS)


def igblast_command(image):
    return ["docker", "run", "--rm", "-v", "{}:/work".format(BACKEND), "-w", "/work/igblast", image,
            "bash", "-c", IGBLAST_BUILD]


def build_igblast():
    """Build the IgBLAST databases in the Docker image, unless they are built. True unless it failed."""
    if igblast_built():
        status("skip", "IgBLAST databases", "already built (mouse and human, Ig and TCR panels)")
        return True
    image = docker_image()
    if not image:
        status("warn", "IgBLAST databases", "not built: no tbrc-backend Docker image is available",
               "build the image ({}): ./tbrc setup --build-images, or {}; or, with the tools installed natively: "
               "cd backend/igblast && ./setup_igblast_databases.sh all all".format(
                   BUILD_TIME, command_text(build_command(SETUP_BACKEND_IMAGE, "backend"))))
        return True
    say("Building the IgBLAST databases in {} (a minute or so) ...".format(image))
    rc, _, _ = run(igblast_command(image), stream=True)
    if rc != 0:
        status("fail", "IgBLAST databases", "the build exited with status {}".format(rc),
               "the lines above say why; fix that and run ./tbrc setup again (it skips what is done)")
        return False
    status("ok", "IgBLAST databases", "built")
    return True


